# Backend the app talks to while developing (`npx expo start`): the deployed Cloudflare Worker,
# so you don't need to run the backend on your computer.
EXPO_PUBLIC_API_URL=https://gymtrack-backend.20912020100658.workers.dev

# To work on the backend itself, run it locally (`cd backend && npm run dev`) and use this instead.
# On a phone/emulator, "localhost" is automatically pointed at the computer running Expo.
# EXPO_PUBLIC_API_URL=http://localhost:4000
