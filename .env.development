# Backend the app talks to while developing (`npx expo start`).
# Branch v2: the new platform API (platform-api/, .NET) running locally in Docker (`docker compose up -d` there).
# On a phone/emulator, "localhost" is automatically pointed at the computer running Expo.
EXPO_PUBLIC_API_URL=http://localhost:5080

